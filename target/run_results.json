(select * from \"postgres\".\"public\".\"activity\" where changed_field_key = 'stage_id') dbt_subquery\n    where deal_id is not null\n),\n\nparent as (\n    select deal_id as to_field\n    from \"postgres\".\"public\".\"deal_changes\"\n)\n\nselect\n    from_field\n\nfrom child\nleft join parent\n    on child.from_field = parent.to_field\n\nwhere parent.to_field is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-02-03T13:06:39.254054Z", "completed_at": "2026-02-03T13:06:39.281662Z"}, {"name": "execute", "started_at": "2026-02-03T13:06:39.281816Z", "completed_at": "2026-02-03T13:06:39.281820Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.028074979782104492, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enpal_assessment_project.source_unique_postgres_public_activity_types_id.4fad3748ba", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    id as unique_field,\n    count(*) as n_records\n\nfrom \"postgres\".\"public\".\"activity_types\"\nwhere id is not null\ngroup by id\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-02-03T13:06:39.282472Z", "completed_at": "2026-02-03T13:06:39.284274Z"}, {"name": "execute", "started_at": "2026-02-03T13:06:39.284404Z", "completed_at": "2026-02-03T13:06:39.284407Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0022399425506591797, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enpal_assessment_project.source_unique_postgres_public_fields_ID.ea05692928", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    ID as unique_field,\n    count(*) as n_records\n\nfrom \"postgres\".\"public\".\"fields\"\nwhere ID is not null\ngroup by ID\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-02-03T13:06:39.285006Z", "completed_at": "2026-02-03T13:06:39.286586Z"}, {"name": "execute", "started_at": "2026-02-03T13:06:39.286722Z", "completed_at": "2026-02-03T13:06:39.286725Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0020208358764648438, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enpal_assessment_project.source_unique_postgres_public_stages_stage_id.c42bb03b32", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    stage_id as unique_field,\n    count(*) as n_records\n\nfrom \"postgres\".\"public\".\"stages\"\nwhere stage_id is not null\ngroup by stage_id\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-02-03T13:06:39.287426Z", "completed_at": "2026-02-03T13:06:39.288854Z"}, {"name": "execute", "started_at": "2026-02-03T13:06:39.288991Z", "completed_at": "2026-02-03T13:06:39.288994Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0018601417541503906, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enpal_assessment_project.source_unique_postgres_public_users_id.981d49341d", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    id as unique_field,\n    count(*) as n_records\n\nfrom \"postgres\".\"public\".\"users\"\nwhere id is not null\ngroup by id\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-02-03T13:06:39.289613Z", "completed_at": "2026-02-03T13:06:39.291012Z"}, {"name": "execute", "started_at": "2026-02-03T13:06:39.291147Z", "completed_at": "2026-02-03T13:06:39.291149Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0018219947814941406, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.enpal_assessment_project.int_deal_activities", "compiled": true, "compiled_code": "\n\n-- Sales Call 1 and Sales Call 2 - first occurrence\nWITH activity_with_types AS (\n    SELECT\n        a.deal_id,\n        a.activity_type_code,\n        at.activity_type_id,\n        at.activity_type_name,\n        a.due_to\n    FROM \"postgres\".\"public_pipedrive_analytics\".\"stg_activity\" a\n    LEFT JOIN \"postgres\".\"public_pipedrive_analytics\".\"stg_activity_types\" at\n        ON a.activity_type_code = at.activity_type_code\n    WHERE at.activity_type_id IN (1, 2)\n),\n\nfirst_activity AS (\n    SELECT\n        deal_id,\n        activity_type_id,\n        activity_type_name,\n        MIN(due_to) AS first_activity_time\n    FROM activity_with_types\n    WHERE due_to IS NOT NULL\n    GROUP BY deal_id, activity_type_id, activity_type_name\n)\n\nSELECT\n    deal_id,\n    activity_type_id,\n    activity_type_name,\n    first_activity_time,\n    DATE_TRUNC('month', first_activity_time) AS activity_month\nFROM first_activity", "relation_name": "\"postgres\".\"public_pipedrive_analytics\".\"int_deal_activities\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-02-03T13:06:39.291774Z", "completed_at": "2026-02-03T13:06:39.292940Z"}, {"name": "execute", "started_at": "2026-02-03T13:06:39.293079Z", "completed_at": "2026-02-03T13:06:39.293082Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0015990734100341797, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.enpal_assessment_project.int_deal_stage_transitions", "compiled": true, "compiled_code": "\n\n-- first time deals enter each stage (using MIN)\nWITH stage_changes AS (\n    SELECT\n        deal_id,\n        change_time,\n        stage_id\n    FROM \"postgres\".\"public_pipedrive_analytics\".\"stg_deal_changes\"\n    WHERE changed_field_key = 'stage_id'\n        AND stage_id IS NOT NULL\n),\n\nfirst_entry AS (\n    SELECT\n        deal_id,\n        stage_id,\n        MIN(change_time) AS first_entry_time\n    FROM stage_changes\n    GROUP BY deal_id, stage_id\n)\n\nSELECT\n    deal_id,\n    stage_id,\n    first_entry_time,\n    DATE_TRUNC('month', first_entry_time) AS entry_month\nFROM first_entry", "relation_name": "\"postgres\".\"public_pipedrive_analytics\".\"int_deal_stage_transitions\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-02-03T13:06:39.293905Z", "completed_at": "2026-02-03T13:06:39.295621Z"}, {"name": "execute", "started_at": "2026-02-03T13:06:39.295764Z", "completed_at": "2026-02-03T13:06:39.295766Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.002174854278564453, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.enpal_assessment_project.int_deal_funnel_entries", "compiled": true, "compiled_code": "\n\n-- combine stages and activities into one\nWITH stage_entries AS (\n    SELECT\n        deal_id,\n        stage_id AS funnel_step,\n        entry_month AS entry_date,\n        'Stage' AS entry_type,\n        NULL AS kpi_name\n    FROM \"postgres\".\"public_pipedrive_analytics\".\"int_deal_stage_transitions\"\n),\n\nsales_call_1_entries AS (\n    SELECT\n        deal_id,\n        2.1 AS funnel_step,\n        activity_month AS entry_date,\n        'Activity' AS entry_type,\n        'Sales Call 1' AS kpi_name\n    FROM \"postgres\".\"public_pipedrive_analytics\".\"int_deal_activities\"\n    WHERE activity_type_id = 1\n),\n\nsales_call_2_entries AS (\n    SELECT\n        deal_id,\n        3.1 AS funnel_step,\n        activity_month AS entry_date,\n        'Activity' AS entry_type,\n        'Sales Call 2' AS kpi_name\n    FROM \"postgres\".\"public_pipedrive_analytics\".\"int_deal_activities\"\n    WHERE activity_type_id = 2\n),\n\nall_entries AS (\n    SELECT * FROM stage_entries\n    UNION ALL\n    SELECT * FROM sales_call_1_entries\n    UNION ALL\n    SELECT * FROM sales_call_2_entries\n)\n\nSELECT\n    deal_id,\n    funnel_step,\n    entry_date,\n    entry_type,\n    kpi_name\nFROM all_ent